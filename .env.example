# Environment Configuration Template
# CyberGuard | Password Strength Analyzer & Security Suggestion Tool

# Server Configuration
FLASK_APP=backend/app.py
FLASK_ENV=development
PORT=5000
HOST=127.0.0.1

# Privacy Directives
ZERO_PERSISTENCE_MODE=true
ENABLE_ANONYMIZED_TELEMETRY=true
ALLOW_REMOTE_API=false

# Password Policy Defaults
DEFAULT_MIN_PASSWORD_LENGTH=12
DEFAULT_MAX_PASSWORD_LENGTH=128
REJECT_COMMON_PASSWORDS=true
REJECT_PERSONAL_CONTEXT=true
